# Vite proxy target when launching Vite manually (the quick launcher sets it).
# PowerShell: $env:SOLAR_API_BASE_URL = "http://127.0.0.1:8000"
SOLAR_API_BASE_URL=http://127.0.0.1:8000
# Relative paths resolve against the project root.
SOLAR_DB_PATH=solar.db
SOLAR_DAILY_API_LIMIT=50
# This file documents environment variables; it is NOT loaded automatically.
# Optional Node.js executable when it is not on PATH (quick launcher).
# GES_NODE_PATH=C:/Program Files/nodejs/node.exe
